@page "/login"
@rendermode InteractiveServer
@layout WarehouseManagement.Web.Components.Layout.AuthLayout
@using System.ComponentModel.DataAnnotations
@using WarehouseManagement.Web.Models
@inject WarehouseManagement.Web.Services.LoginService LoginService
@inject NavigationManager NavigationManager

<div class="bg-slate-900/60 border border-slate-800/80 rounded-2xl p-8 shadow-2xl backdrop-blur-xl">
    <!-- Tiêu đề Form -->
    <div class="mb-8 text-center">
        <h2 class="text-2xl font-bold text-slate-100 tracking-tight mb-2">Chào mừng trở lại</h2>
        <p class="text-sm text-slate-400">Vui lòng đăng nhập để quản lý hệ thống kho</p>
    </div>

    <!-- Thông báo lỗi chung từ API nếu đăng nhập thất bại -->
    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="mb-5 p-3 rounded-lg bg-rose-500/10 border border-rose-500/20 flex items-center gap-2.5 text-rose-400 text-sm animate-shake">
            <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            <span>@_errorMessage</span>
        </div>
    }

    <!-- Blazor EditForm chuẩn hóa -->
    <EditForm Model="@_loginModel" OnValidSubmit="HandleLoginSubmit" FormName="login-form">
        <DataAnnotationsValidator />

        <!-- Ô nhập Tài khoản -->
        <div class="mb-5">
            <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2" for="username">Tài khoản</label>
            <div class="relative">
                <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-500">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                    </svg>
                </span>
                <InputText id="username" @bind-Value="_loginModel.Username"
                           class="w-full bg-slate-950/50 border border-slate-800 rounded-xl py-2.5 pl-10 pr-4 text-slate-200 placeholder-slate-600 focus:outline-hidden focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-all text-sm"
                           placeholder="Nhập tên đăng nhập..." />
            </div>
            <div class="mt-1.5 text-xs text-rose-400 font-medium">
                <ValidationMessage For="@(() => _loginModel.Username)" />
            </div>
        </div>

        <!-- Ô nhập Mật khẩu -->
        <div class="mb-6">
            <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2" for="password">Mật khẩu</label>
            <div class="relative">
                <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-500">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                    </svg>
                </span>
                <InputText id="password" type="password" @bind-Value="_loginModel.Password"
                           class="w-full bg-slate-950/50 border border-slate-800 rounded-xl py-2.5 pl-10 pr-4 text-slate-200 placeholder-slate-600 focus:outline-hidden focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-all text-sm"
                           placeholder="••••••••" />
            </div>
            <div class="mt-1.5 text-xs text-rose-400 font-medium">
                <ValidationMessage For="@(() => _loginModel.Password)" />
            </div>
        </div>

        <!-- Nút Đăng nhập & Hiệu ứng Loading chặn gửi trùng lặp -->
        <button type="submit" disabled="@_isSubmitting"
                class="w-full bg-indigo-600 hover:bg-indigo-500 disabled:bg-indigo-600/50 text-white font-semibold py-2.5 px-4 rounded-xl text-sm transition-all duration-150 cursor-pointer shadow-lg shadow-indigo-600/20 flex items-center justify-center gap-2">
            @if (_isSubmitting)
            {
                <svg class="animate-spin h-5 w-5 text-white" xmlns="http://w3.org" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
                <span>Đang xác thực...</span>
            }
            else
            {
                <span>Đăng nhập hệ thống</span>
            }
        </button>
    </EditForm>
</div>

@code {
    private LoginViewModel _loginModel = new();
    private bool _isSubmitting = false;
    private string? _errorMessage;

    private async Task HandleLoginSubmit()
    {
        if (_isSubmitting) return;

        try
        {
            _isSubmitting = true;
            _errorMessage = null;

            // ✅ ĐÃ SỬA CHÍNH XÁC: Truyền trực tiếp 2 chuỗi văn bản độc lập vào hàm LoginAsync theo đúng file gốc của bạn
            var result = await LoginService.LoginAsync(_loginModel.Username, _loginModel.Password);

            if (result.Success)
            {
                // Đăng nhập thành công, điều hướng thẳng vào trang Dashboard tổng quan
                NavigationManager.NavigateTo("");
            }
            else
            {
                // Tận dụng chuỗi thông báo lỗi nghiệp vụ chi tiết trả về từ LoginService để in ra UI
                _errorMessage = result.Message;
            }
        }
        catch (Exception)
        {
            _errorMessage = "Không thể kết nối tới máy chủ API. Vui lòng kiểm tra lại kết nối mạng.";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    // Lớp Model nội bộ phục vụ riêng cho Validation giao diện (Fluent/DataAnnotations UI)
    public class LoginViewModel
    {
        [Required(ErrorMessage = "Tài khoản không được để trống.")]
        [StringLength(50, ErrorMessage = "Tài khoản không được vượt quá 50 ký tự.")]
        public string Username { get; set; } = string.Empty;

        [Required(ErrorMessage = "Mật khẩu không được để trống.")]
        [MinLength(4, ErrorMessage = "Mật khẩu phải chứa ít nhất 4 ký tự.")]
        public string Password { get; set; } = string.Empty;
    }
}
