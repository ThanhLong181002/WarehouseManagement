@page "/access-denied"
@inject NavigationManager NavigationManager

<div class="min-h-[70vh] flex flex-col items-center justify-center p-6 text-center animate-fade-in select-none">
    <!-- Icon Cảnh báo Phân quyền (Mã hiệu hình khóa bảo mật) -->
    <div class="mb-6 p-4 rounded-full bg-rose-500/10 text-rose-400 border border-rose-500/20 shadow-lg shadow-rose-500/5 animate-pulse">
        <svg class="w-14 h-14" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://w3.org">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
        </svg>
    </div>

    <!-- Nội dung thông báo lỗi -->
    <div class="max-w-md space-y-3">
        <h2 class="text-2xl font-bold text-slate-100 tracking-tight">Truy cập bị từ chối</h2>
        <p class="text-sm text-slate-400 leading-relaxed">
            Tài khoản hiện tại của bạn không có đủ đặc quyền để xem nội dung trang này. Vui lòng liên hệ với Quản trị viên hệ thống nếu bạn cho rằng đây là một sự nhầm lẫn.
        </p>
    </div>

    <!-- Thanh điều hướng xử lý nhanh -->
    <div class="mt-8 flex items-center gap-3">
        <button @onclick="NavigateToHome" 
                class="bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-xs px-4 py-2.5 rounded-xl transition-all shadow-lg shadow-indigo-600/10 cursor-pointer flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11V11a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h4a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/>
            </svg>
            <span>Quay về Dashboard</span>
        </button>
    </div>
</div>

@code {
    private void NavigateToHome() => NavigationManager.NavigateTo("");
}
