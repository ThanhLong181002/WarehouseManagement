@page "/users"
@using WarehouseManagement.Web.Models
@using WarehouseManagement.Web.Services
@inject WarehouseManagement.Web.Services.WarehouseApiClient ApiClient
@inject WarehouseManagement.Web.Services.TokenSession TokenSession
@inject NavigationManager NavigationManager

<div class="space-y-6 animate-fade-in">
    <!-- Tiêu đề & Nút Thêm mới -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-slate-100 tracking-tight">Quản lý Người dùng</h1>
            <p class="text-sm text-slate-400 mt-1">Quản trị danh sách tài khoản, phân chia vai trò và trạng thái hoạt động của nhân sự.</p>
        </div>
        <button class="bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-semibold px-4 py-2.5 rounded-xl transition-colors shadow-lg shadow-indigo-600/10 cursor-pointer flex items-center gap-2 self-start sm:self-auto">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
            </svg>
            <span>Tạo tài khoản mới</span>
        </button>
    </div>

    <!-- Thanh Tìm kiếm và Bộ lọc -->
    <div class="bg-slate-900/40 border border-slate-800/80 rounded-xl p-4 flex flex-col sm:flex-row gap-4 items-center">
        <div class="relative w-full sm:flex-1">
            <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-500">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                </svg>
            </span>
            <input type="text" @bind-value="_searchQuery" @bind-value:event="oninput" @onkeyup="ApplyFilters"
                   class="w-full bg-slate-950/50 border border-slate-800 rounded-xl py-2 pl-10 pr-4 text-slate-200 placeholder-slate-600 focus:outline-hidden focus:border-indigo-500 text-sm transition-all"
                   placeholder="Tìm theo tài khoản, họ tên hoặc email..." />
        </div>
        <div class="w-full sm:w-48">
            <select @onchange="OnRoleFilterChanged" class="w-full bg-slate-950/50 border border-slate-800 rounded-xl py-2 px-3 text-slate-300 focus:outline-hidden focus:border-indigo-500 text-sm transition-all cursor-pointer">
                <option value="all">Tất cả vai trò</option>
                <option value="Admin">Quản trị viên (Admin)</option>
                <option value="Manager">Quản lý kho (Manager)</option>
                <option value="Staff">Nhân viên kho (Staff)</option>
            </select>
        </div>
    </div>

    <!-- Khu vực hiển thị bảng dữ liệu -->
    @if (_isLoading)
    {
        <div class="border border-slate-800/60 rounded-xl overflow-hidden bg-slate-900/20 animate-pulse space-y-4 p-4">
            <div class="h-8 bg-slate-800 rounded-md w-full"></div>
            <div class="h-12 bg-slate-800/50 rounded-lg w-full"></div>
            <div class="h-12 bg-slate-800/50 rounded-lg w-full"></div>
        </div>
    }
    else if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="p-4 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-400 text-sm flex justify-between items-center">
            <span>@_errorMessage</span>
            <button @onclick="LoadUsers" class="px-3 py-1 bg-rose-500/20 rounded-lg text-xs font-semibold cursor-pointer hover:bg-rose-500/30 transition-all">Thử lại</button>
        </div>
    }
    else
    {
        <div class="border border-slate-800/80 rounded-xl overflow-hidden bg-slate-900/20 shadow-xs">
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse text-sm">
                    <thead>
                        <tr class="bg-slate-900/60 border-b border-slate-800 text-slate-400 font-semibold select-none">
                            <th class="px-6 py-3.5">Tài khoản</th>
                            <th class="px-6 py-3.5">Họ và tên</th>
                            <th class="px-6 py-3.5">Email liên hệ</th>
                            <th class="px-6 py-3.5">Vai trò</th>
                            <th class="px-6 py-3.5">Đăng nhập cuối</th>
                            <th class="px-6 py-3.5 text-center">Trạng thái</th>
                            <th class="px-6 py-3.5 text-right">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-800/60 text-slate-300">
                        @if (!_filteredUsers.Any())
                        {
                            <tr>
                                <td colspan="7" class="px-6 py-10 text-center text-slate-500 font-medium">
                                    Không tìm thấy tài khoản người dùng nào phù hợp.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var user in _filteredUsers)
                            {
                                <tr class="hover:bg-slate-900/30 transition-colors">
                                    <td class="px-6 py-3.5 font-bold text-indigo-400 select-all">@user.Username</td>
                                    <td class="px-6 py-3.5 font-medium text-slate-200">@user.FullName</td>
                                    <td class="px-6 py-3.5 text-slate-400">@user.Email</td>
                                    <td class="px-6 py-3.5">
                                        <span class="inline-flex px-2 py-0.5 text-xxs font-semibold rounded border @GetRoleStyle(user.Role)">
                                            @user.Role
                                        </span>
                                    </td>
                                    <td class="px-6 py-3.5 text-slate-400 text-xs">
                                        @(user.LastLogin?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa từng đăng nhập")
                                    </td>
                                    <td class="px-6 py-3.5 text-center">
                                        @if (user.IsActive)
                                        {
                                            <span class="inline-flex px-2 py-0.5 text-xxs font-semibold bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 rounded-md">Kích hoạt</span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex px-2 py-0.5 text-xxs font-semibold bg-rose-500/10 border border-rose-500/20 text-rose-400 rounded-md">Bị khóa</span>
                                        }
                                    </td>
                                    <td class="px-6 py-3.5 text-right">
                                        <button class="text-slate-400 hover:text-indigo-400 p-1.5 rounded-lg hover:bg-indigo-500/10 transition-colors cursor-pointer inline-flex items-center" title="Chỉnh sửa quyền">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                            </svg>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private List<UserItemDto> _users = new();
    private List<UserItemDto> _filteredUsers = new();
    private bool _isLoading = true;
    private string? _errorMessage;

    private string _searchQuery = "";
    private string _selectedRole = "all";

    protected override async Task OnInitializedAsync()
    {
        // 🛡️ Kiểm tra an toàn: Đảm bảo quyền hạn C# của tài khoản khớp hoàn toàn với chuỗi quyền Admin
        if (string.IsNullOrWhiteSpace(TokenSession.Role) || 
            !TokenSession.Role.Equals("Admin", StringComparison.OrdinalIgnoreCase))
        {
            _errorMessage = "Tài khoản của bạn không có thẩm quyền truy cập danh mục Quản trị người dùng.";
            _isLoading = false;
            return;
        }

        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        try
        {
            _isLoading = true;
            _errorMessage = null;

            // 🚀 Gọi đến DTO bọc phân trang đã thiết lập ở tầng Backend máy chủ
            var result = await ApiClient.GetAsync<UserPagedResponseDto>("api/users?page=1&pageSize=100");
            if (result != null && result.Items != null)
            {
                _users = result.Items;
                ApplyFilters();
            }
        }
        catch (ApiUnauthorizedException)
        {
            TokenSession.ClearSession();
            NavigationManager.NavigateTo("/login", forceLoad: true);
        }
        catch (ApiForbiddenException)
        {
            _errorMessage = "Yêu cầu bị hệ thống từ chối. Tài khoản của bạn không đủ đặc quyền.";
        }
        catch (Exception)
        {
            _errorMessage = "Lỗi kết nối máy chủ API. Không thể tải danh mục người dùng.";
        }
        finally
        {
            _isLoading = false;
        }
    }

        private void OnRoleFilterChanged(ChangeEventArgs e)
    {
        _selectedRole = e.Value?.ToString() ?? "all";
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        var query = _users.AsQueryable();

        if (!string.IsNullOrWhiteSpace(_searchQuery))
        {
            string searchLower = _searchQuery.ToLower();
            query = query.Where(u => u.Username.ToLower().Contains(searchLower) ||
                                     u.FullName.ToLower().Contains(searchLower));
        }

        if (_selectedRole != "all")
        {
            query = query.Where(u => u.Role.Equals(_selectedRole, StringComparison.OrdinalIgnoreCase));
        }

        _filteredUsers = query.ToList();
    }

    private string GetRoleStyle(string role) => role switch
    {
        "Admin"   => "bg-purple-500/10 border-purple-500/20 text-purple-400",
        "Manager" => "bg-indigo-500/10 border-indigo-500/20 text-indigo-400",
        _         => "bg-slate-800 border-slate-700 text-slate-400"
    };
}
