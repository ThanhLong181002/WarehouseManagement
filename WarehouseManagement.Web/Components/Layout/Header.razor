@inject WarehouseManagement.Web.Services.TokenSession TokenSession
@inject NavigationManager NavigationManager
@implements IDisposable

<header class="app-header bg-slate-900 border-b border-slate-800 text-white h-16 min-h-16 px-6 flex items-center justify-between shadow-xs">
    <button type="button" class="mobile-menu-toggle" aria-label="Mở menu điều hướng" aria-expanded="false" @onclick="OnMenuClick">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
    </button>
    <!-- Trái: Tên hệ thống -->
    <div class="flex items-center gap-3">
        <!-- Icon Hệ Thống (Mã SVG trực tiếp) -->
        <svg class="w-7 h-7 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://w3.org">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
        </svg>
        <span class="font-bold text-lg tracking-wide bg-gradient-to-r from-white to-slate-400 bg-clip-text text-transparent">
            <span class="header-brand-text">WAREHOUSE MANAGEMENT</span>
        </span>
    </div>

    <!-- Phải: Thông tin người dùng & Menu Chức năng -->
    <div class="flex items-center gap-4">
        @if (TokenSession.IsAuthenticated)
        {
            <!-- Vùng chứa có vị trí tương đối (relative) để làm gốc định vị cho Dropdown -->
            <div class="relative">

                <!-- KHÔI PHỤC NÚT BẤM: Chứa Avatar và Tên tài khoản để kích hoạt Click -->
                <button @onclick="ToggleUserMenu"
                        class="flex items-center gap-3 focus:outline-hidden cursor-pointer py-1.5 text-left rounded-xl hover:bg-slate-800/40 px-2 transition-all">

                    <!-- Avatar lấy chữ cái đầu của Username -->
                    <div class="w-9 h-9 rounded-full bg-indigo-600/20 text-indigo-400 flex items-center justify-center font-bold text-sm border border-indigo-500/40 shadow-xs">
                        @(string.IsNullOrWhiteSpace(TokenSession.Username) ? "U" : TokenSession.Username.Substring(0, 1).ToUpper())
                    </div>

                    <!-- Tên và Quyền (Ẩn trên màn hình mobile nhỏ, hiện từ md trở lên) -->
                    <div class="hidden md:block select-none">
                        <p class="text-sm font-medium text-slate-200">@TokenSession.Username</p>
                        <p class="text-xxs text-slate-400 mt-0.5">@TokenSession.Role</p>
                    </div>

                    <!-- Mũi tên chỉ hướng xuống, tự động xoay ngược 180 độ khi menu mở -->
                    <svg class="w-4 h-4 text-slate-400 transition-transform duration-200 @(_isMenuOpen ? "rotate-180" : "")"
                         fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://w3.org">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                    </svg>
                </button>

                <!-- ĐỊNH VỊ CHUẨN: Thả xuống (Dropdown Menu) - Chỉ render khi _isMenuOpen = true -->
                @if (_isMenuOpen)
                {
                    <div class="absolute right-0 top-full mt-2 w-52 bg-slate-800 border border-slate-700 rounded-xl shadow-xl z-50 py-1 transition-all duration-200 animate-in fade-in zoom-in-95 duration-100">

                        <!-- Thông tin chi tiết hiển thị riêng trên giao diện di động (Mobile) -->
                        <div class="px-4 py-2 border-b border-slate-700/60 md:hidden">
                            <p class="text-sm font-semibold text-slate-200">@TokenSession.Username</p>
                            <p class="text-xs text-slate-400">@TokenSession.Role</p>
                        </div>

                        <!-- Chức năng 1: Chỉnh sửa hồ sơ cá nhân -->
                        <button @onclick="NavigateToProfile"
                                class="w-full flex items-center gap-3 px-4 py-2.5 text-sm text-slate-300 hover:text-white hover:bg-slate-700/50 transition-colors text-left cursor-pointer">
                            <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://w3.org">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 00-2 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                            </svg>
                            <span>Chỉnh sửa hồ sơ</span>
                        </button>

                        <!-- Chức năng 2: Cài đặt hệ thống -->
                        <button @onclick="NavigateToSettings"
                                class="w-full flex items-center gap-3 px-4 py-2.5 text-sm text-slate-300 hover:text-white hover:bg-slate-700/50 transition-colors text-left cursor-pointer">
                            <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://w3.org">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                            </svg>
                            <span>Cài đặt</span>
                        </button>

                        <div class="border-t border-slate-700/60 my-1"></div>

                        <!-- Chức năng 3: Đăng xuất tài khoản -->
                        <button @onclick="HandleLogout"
                                class="w-full flex items-center gap-3 px-4 py-2.5 text-sm text-rose-400 hover:bg-rose-500/10 transition-colors text-left cursor-pointer">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://w3.org">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                            </svg>
                            <span>Đăng xuất</span>
                        </button>
                    </div>
                }
            </div>
        }
        else
        {
            <button @onclick="NavigateToLogin"
                    class="text-xs text-amber-500 bg-amber-500/10 px-3 py-1.5 rounded-lg border border-amber-500/20 font-medium animate-pulse hover:bg-amber-500/20 transition-all cursor-pointer">
                Chưa xác thực
            </button>
        }
    </div>
</header>

@code {
    [Parameter] public EventCallback OnMenuClick { get; set; }

    private bool _isMenuOpen = false;

    protected override void OnInitialized()
    {
        TokenSession.OnSessionChanged += StateHasChanged;
    }

    private void ToggleUserMenu()
    {
        _isMenuOpen = !_isMenuOpen;
    }

    private void NavigateToLogin()
    {
        _isMenuOpen = false;
        NavigationManager.NavigateTo("/login");
    }

    private void NavigateToProfile()
    {
        _isMenuOpen = false;
        NavigationManager.NavigateTo("/profile");
    }

    private void NavigateToSettings()
    {
        _isMenuOpen = false;
        NavigationManager.NavigateTo("/settings");
    }

    private void HandleLogout()
    {
        _isMenuOpen = false;
        TokenSession.ClearSession();
        NavigationManager.NavigateTo("/login", forceLoad: true);
    }

    public void Dispose()
    {
        TokenSession.OnSessionChanged -= StateHasChanged;
    }
}
